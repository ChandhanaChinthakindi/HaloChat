# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Railway provides this automatically as $DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# OpenAI API key — used for chat completions, TTS, and Whisper transcription
OPENAI_API_KEY=sk-...

# JWT signing secrets — use long random strings (at least 32 characters each)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Port the HTTP server listens on (Railway injects this automatically)
PORT=3000

# ── Optional ──────────────────────────────────────────────────────────────────

# Resend API key — required for password reset emails
# RESEND_API_KEY=re_...

# Email sender address shown to users
FROM_EMAIL=HaloChat <noreply@halochat.app>

# Deep-link scheme used in password reset emails
APP_SCHEME=halochat

# CORS allowed origin in production (e.g. https://halochat.app)
# Defaults to * in development, blocked in production if not set
CORS_ORIGIN=

# Max AI messages per user per companion per day (default: 200)
DAILY_COMPANION_LIMIT=200
